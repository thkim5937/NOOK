# Runtime environment name (local, staging, production)
APP_ENV=local
# Database connection URL (unused for now)
DATABASE_URL=
# API key for the LLM provider (placeholder, never commit a real key)
LLM_API_KEY=your-llm-api-key-here
# Max LLM calls allowed per day
LLM_DAILY_CALL_LIMIT=100
# Supabase project URL (<project-url>); leave empty to disable token verification
SUPABASE_URL=
# Expected "aud" claim of Supabase access tokens
SUPABASE_JWT_AUDIENCE=authenticated
