{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOOK sample businesses (DRAFT, provisional)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "businesses"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "note",
        "provisional_options"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "provisional_options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "target_customers",
            "slow_times",
            "mood_tags"
          ],
          "properties": {
            "category": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "target_customers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "slow_times": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "mood_tags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "businesses": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "business_name",
          "district",
          "category",
          "target_customers",
          "slow_times",
          "mood_tags",
          "ai_intro"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "business_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "district": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 50
          },
          "category": {
            "type": "string",
            "maxLength": 50,
            "pattern": "^[a-z][a-z0-9_]*$",
            "enum": [
              "cafe",
              "bakery",
              "restaurant",
              "bookstore",
              "flower_shop",
              "gallery",
              "fitness_studio",
              "pottery_workshop",
              "vintage_shop",
              "bar"
            ]
          },
          "target_customers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "teens",
                "20s",
                "30s",
                "40s_plus",
                "students",
                "office_workers",
                "couples",
                "families",
                "tourists"
              ]
            }
          },
          "slow_times": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "weekday_morning",
                "weekday_afternoon",
                "weekday_evening",
                "weekend_morning",
                "weekend_afternoon",
                "weekend_evening"
              ]
            }
          },
          "mood_tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "quiet",
                "warm",
                "cozy",
                "minimal",
                "trendy",
                "lively",
                "premium",
                "casual",
                "artistic"
              ]
            }
          },
          "ai_intro": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        }
      }
    }
  }
}
